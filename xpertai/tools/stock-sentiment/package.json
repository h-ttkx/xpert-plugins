{
  "name": "@helloxiaohu/plugin-stock-sentiment",
  "version": "1.0.1",
  "description": "股票情绪分析插件 - 分析股票市场情绪和舆情",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@xpert-plugins-starter/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "jest -c jest.config.ts --runInBand"
  },
  "dependencies": {
    "@langchain/core": "0.3.72",
    "@nestjs/common": "^11.1.6",
    "@xpert-ai/plugin-sdk": "^3.6.2",
    "axios": "^1.7.9",
    "tslib": "^2.3.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "jest": "^29.7.0",
    "typescript": "~5.7.3"
  },
  "keywords": [
    "stock",
    "sentiment",
    "analysis",
    "A股",
    "港股",
    "情绪分析"
  ],
  "author": "Xpert AI",
